# PgBee Landing - Environment Variables Example
# Copy this file to .env.local and fill in your values
# Never commit .env.local or any .env files with real values

# =============================================================================
# Next.js Configuration
# =============================================================================
# The environment Next.js runs in (development, production, test)
NODE_ENV=development

# =============================================================================
# Analytics & Tracking
# =============================================================================
# Vercel Analytics (enabled by default on Vercel)
# Get your ID from Vercel Project Settings > Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Tag Manager Container ID
# Format: GTM-XXXXXX
NEXT_PUBLIC_GTM_ID=

# =============================================================================
# External Services
# =============================================================================
# API Base URL for backend services (if landing page calls APIs)
# Example: https://api.pgbee.com/v1
NEXT_PUBLIC_API_BASE_URL=

# reCAPTCHA Site Key for contact forms
# Get from Google reCAPTCHA Admin Console
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# =============================================================================
# Feature Flags
# =============================================================================
# Enable/disable features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
NEXT_PUBLIC_ENABLE_CHAT_WIDGET=false

# =============================================================================
# Social & External Links
# =============================================================================
# Play Store URL for app download
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.pgbee

# App Store URL for iOS app
NEXT_PUBLIC_APP_STORE_URL=

# Company contact email
NEXT_PUBLIC_CONTACT_EMAIL=support@pgbee.com

# Company phone number
NEXT_PUBLIC_CONTACT_PHONE=+91-XXXXXXXXXX

# =============================================================================
# CDN & Asset Configuration
# =============================================================================
# Custom CDN domain for static assets (optional)
# Example: https://cdn.pgbee.com
NEXT_PUBLIC_CDN_URL=

# Image optimization domains (comma-separated)
# Used by next/image for external images
NEXT_PUBLIC_IMAGE_DOMAINS=

# =============================================================================
# Development Overrides
# =============================================================================
# Override API URL for local development
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Disable analytics in development
# NEXT_PUBLIC_ENABLE_ANALYTICS=false