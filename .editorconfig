root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,jsx,ts,tsx,json,md,css,html,yaml,yml}]
indent_size = 2

[*.{json,md}]
indent_size = 2

[Makefile]
indent_style = tab

# Match pnpm lockfile
pnpm-lock.yaml
indent_size = 2